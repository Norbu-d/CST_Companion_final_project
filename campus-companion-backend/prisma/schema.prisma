generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  LECTURER
  ADMIN
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Department {
  SOFTWARE_ENGINEERING
  INFORMATION_TECHNOLOGY
  ELECTRICAL_ENGINEERING
  CIVIL_ENGINEERING
  MECHANICAL_ENGINEERING
  ELECTRONICS_ENGINEERING
  INSTRUMENTATION_ENGINEERING
  ARCHITECTURE
  WATER_RESOURCE_ENGINEERING
  GEOLOGY
}

enum Designation {
  HEAD_OF_DEPARTMENT
  SENIOR_LECTURER
  LECTURER
  LAB_TECHNICIAN
  ADMIN_STAFF
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TargetType {
  EVERYONE
  DEPARTMENT
  YEAR_GROUP
  ROLE_ONLY
}

enum TargetRole {
  LECTURERS_ONLY
  STUDENTS_ONLY
}

enum AttachmentType {
  IMAGE
  PDF
  DOCUMENT
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id          Int          @id @default(autoincrement())
  studentId   String       @unique   // student number for students, employeeId for lecturers
  name        String
  email       String       @unique
  password    String
  role        Role         @default(STUDENT)
  department  Department?
  contact     String?

  // Student-specific
  intakeYear  Int?         // year enrolled e.g. 2022 — current year calculated from this
  semester    Int?         // current semester (1 or 2)
  programme   String?      // specific programme within department if applicable
  isRepeating Boolean      @default(false) // true if student is repeating a year

  // Lecturer-specific
  designation Designation? // role within department e.g. HEAD_OF_DEPARTMENT
  officeHours String?      // e.g. "Mon–Fri 9:00–12:00"

  // Notifications
  pushToken   String?      // Expo push notification token, saved on login

  createdAt   DateTime     @default(now())

  bookings       Booking[]
  lecturerLeaves LecturerLeave[]
  sentNotices    Notice[]         @relation("SentBy")
  approvedLeaves LecturerLeave[]  @relation("ApprovedBy")
  schedules      Schedule[]       @relation("LecturerSchedule")

  // ─── Indexes ──────────────────────────────────────────────────────────────
  // Composite index for role + department filtering (contacts page)
  @@index([role, department])
}

model Schedule {
  id           Int        @id @default(autoincrement())
  department   Department                   // which department this class is for
  year         Int                          // student year: 1, 2, 3, 4
  semester     Int                          // 1 or 2
  academicYear String                       // e.g. "2025-26"
  day          String                       // "Monday", "Tuesday" etc
  time         String                       // e.g. "08:00–09:50"
  subject      String                       // subject name
  room         String                       // room or lab identifier
  type         String                       // "Lecture", "Lab", "Tutorial"
  lecturerId   Int?                         // assigned lecturer — null means unassigned
  lecturer     User?      @relation("LecturerSchedule", fields: [lecturerId], references: [id])

  // ─── Indexes ──────────────────────────────────────────────────────────────
  // Composite index for timetable queries (student loads schedule by dept+year+semester+academicYear)
  @@index([department, year, semester, academicYear])
}

model Notice {
  id               Int            @id @default(autoincrement())
  title            String
  body             String
  category         String
  pinned           Boolean        @default(false)
  icon             String         @default("megaphone")
  date             DateTime       @default(now())
  
  // Targeting
  targetType       TargetType     @default(EVERYONE)
  targetDepartment Department?                      // set when targetType = DEPARTMENT or YEAR_GROUP
  targetYear       Int?                             // set when targetType = YEAR_GROUP
  targetRole       TargetRole?                      // set when targetType = ROLE_ONLY
  
  // Sender
  sentById         Int?
  sentBy           User?          @relation("SentBy", fields: [sentById], references: [id])
  
  // Attachments
  attachments      Attachment[]

  // ─── Indexes ──────────────────────────────────────────────────────────────
  // Composite index for DEPARTMENT & YEAR_GROUP targeting queries
  @@index([targetType, targetDepartment, targetYear])
  // Composite index for ROLE_ONLY targeting queries
  @@index([targetType, targetRole])
  // Composite index for pinned + date ordering (pinned desc, then date desc)
  @@index([pinned, date(sort: Desc)])
}

model Facility {
  id          Int       @id @default(autoincrement())
  facilityKey String    @unique
  name        String
  description String
  capacity    Int
  location    String
  color       String
  icon        String
  rules       String[]
  bookings    Booking[]
}

model Booking {
  id         Int           @id @default(autoincrement())
  userId     Int
  facilityId Int
  date       String
  slots      Int[]
  purpose    String
  status     BookingStatus @default(PENDING)
  academicYear String?                            // NEW: e.g. "2025-26"
  createdAt  DateTime      @default(now())
  facility   Facility      @relation(fields: [facilityId], references: [id])
  user       User          @relation(fields: [userId], references: [id])

  // ─── Indexes ──────────────────────────────────────────────────────────────
  // Composite index for user bookings with status filtering
  @@index([userId, status])
  // Index for facility availability queries
  @@index([facilityId, date])
}

model LecturerLeave {
  id           Int           @id @default(autoincrement())
  userId       Int
  startDate    DateTime
  endDate      DateTime
  reason       String?
  status       LeaveStatus   @default(PENDING)   // NEW: approval workflow
  approvedById Int?                               // NEW: which admin approved/rejected
  academicYear String?                            // NEW: e.g. "2025-26"
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id])
  approvedBy   User?         @relation("ApprovedBy", fields: [approvedById], references: [id])

  // ─── Indexes ──────────────────────────────────────────────────────────────
  // Composite index for lecturer leave lookups (filter by userId & status)
  @@index([userId, status])
}

model Attachment {
  id        Int            @id @default(autoincrement())
  noticeId  Int
  fileUrl   String                  // Cloudinary URL
  fileName  String                  // original file name e.g. "timetable_IT_Y3.pdf"
  fileType  AttachmentType
  fileSize  Int                     // in bytes
  createdAt DateTime       @default(now())
  notice    Notice         @relation(fields: [noticeId], references: [id], onDelete: Cascade)
}
